# Settings for `npm run dev` only (read by tsx through --env-file).
# Private keys such as KAKAO_REST_API_KEY go in backend/.env.local instead,
# which git ignores and `npm run dev` reads when it exists.
# No mail service is connected yet, so sign-up shows the code on screen.
EXPOSE_EMAIL_CODES=true
# Brands' store addresses are placed on the map through OpenStreetMap.
NOMINATIM_URL=https://nominatim.openstreetmap.org
