# The keys `npm run dev` can use, with every value left empty. Copy this file
# to backend/.env.local (git ignores it) and fill in the ones you have:
#   cp backend/.env.example backend/.env.local
# Use test keys here, never live ones. A key left empty keeps its feature off,
# and the tests run without any of them. Production keeps its keys in Vercel's
# environment variables, not in a file.

# Payments: Toss Payments' test keys (test_ck_… and test_sk_…). With them the
# card window opens in test mode, no money moves, and the demo brand can pay.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Kakao: the REST API key finds real shops near a campus (가까운 순); the
# JavaScript key draws Kakao's map, for the domains registered with it.
KAKAO_REST_API_KEY=
KAKAO_JS_KEY=

# YouTube Data API v3: public view counts for the SNS posts on an agreement.
YOUTUBE_API_KEY=

# Logging in with Kakao or Naver.
KAKAO_LOGIN_CLIENT_ID=
KAKAO_LOGIN_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# The National Tax Service's business registration check (data.go.kr).
NTS_SERVICE_KEY=

# Mail through Resend: both, or codes and notices go to the server log only.
RESEND_API_KEY=
MAIL_FROM=

# The operators' screen (/admin) and the reminders' cron route stay closed
# while these are empty.
ADMIN_TOKEN=
CRON_SECRET=

# Where error alerts go (once mail is set up).
OPERATOR_EMAIL=
