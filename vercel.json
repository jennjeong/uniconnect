{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "COREPACK_ENABLE_DOWNLOAD_PROMPT=0 corepack pnpm@10.34.3 install --frozen-lockfile",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "regions": ["sin1"],
  "functions": {
    "api/index.mjs": { "maxDuration": 30 }
  },
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/:section(matches|groups)/:id?", "destination": "/index.html" },
    {
      "source": "/:page(dashboard|offers|events|measurement|reports|inbox|campaigns|analytics|new|faq|terms|privacy|admin|council|explore)",
      "destination": "/index.html"
    },
    { "source": "/me/:part(edit)?", "destination": "/index.html" },
    { "source": "/edit/:id", "destination": "/index.html" },
    { "source": "/event/:id", "destination": "/index.html" },
    { "source": "/board/:id?", "destination": "/index.html" },
    { "source": "/:list(messages|agreements)/:id?", "destination": "/index.html" },
    { "source": "/invite/:code([\\w-]+)", "destination": "/index.html" },
    { "source": "/insights/:id", "destination": "/index.html" },
    { "source": "/report/:token([\\w-]+)", "destination": "/index.html" },
    { "source": "/ledger/:token([\\w-]+)", "destination": "/index.html" },
    { "source": "/check-in/:code([\\w-]+)/:part(staff|group)?", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://js.tosspayments.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://*.tosspayments.com; frame-src 'self' https://*.tosspayments.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://*.tosspayments.com; frame-ancestors 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "crons": [{ "path": "/api/cron/reminders", "schedule": "0 0 * * *" }]
}
